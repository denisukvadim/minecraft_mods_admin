server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Mod uploads reach the API through this vhost. nginx defaults to 1 MB and
    # would answer 413 before the backend sees the request, so keep this at
    # least as large as the API's MODS_MAX_UPLOAD_BYTES (128 MiB by default).
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # Backend API (set BACKEND_URL at runtime, e.g. http://backend:8080).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Swagger / OpenAPI docs served by the backend.
    location /docs {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Favicons keep a stable URL, so they must not be cached for long —
    # otherwise browsers (and this vhost) pin the old icon for days.
    location ~* /(?:favicon(?:-\d+x\d+)?\.(?:ico|png|svg)|apple-touch-icon\.png)$ {
        expires -1;
        try_files $uri =404;
    }

    # Fingerprinted assets can be cached aggressively.
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|ico|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback: every client-side route resolves to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               application/xml image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
}
